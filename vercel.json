{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.pinpointaccountingservice.com"
        }
      ],
      "destination": "https://pinpointaccountingservice.com/:path*",
      "permanent": true
    },
    {
      "source": "/blutenstein-growth-os",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/blutenstein-growth-os/",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/blutenstein-growth-os/:path*",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os-dashboard",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os-dashboard/",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os-dashboard/:path*",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os/",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os/:path*",
      "destination": "https://blutenstein.com/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://pinpointaccountingservice.com/>; rel=\"alternate\"; hreflang=\"th\", <https://pinpointaccountingservice.com/en>; rel=\"alternate\"; hreflang=\"en\", <https://pinpointaccountingservice.com/>; rel=\"alternate\"; hreflang=\"x-default\""
        }
      ]
    },
    {
      "source": "/en",
      "headers": [
        {
          "key": "Link",
          "value": "<https://pinpointaccountingservice.com/>; rel=\"alternate\"; hreflang=\"th\", <https://pinpointaccountingservice.com/en>; rel=\"alternate\"; hreflang=\"en\", <https://pinpointaccountingservice.com/>; rel=\"alternate\"; hreflang=\"x-default\""
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
