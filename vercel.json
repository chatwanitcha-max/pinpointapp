{
  "redirects": [
    {
      "source": "/blutenstein-growth-os",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/blutenstein-growth-os/",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/blutenstein-growth-os/:path*",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os-dashboard",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os-dashboard/",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os-dashboard/:path*",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os/",
      "destination": "https://blutenstein.com/",
      "permanent": false
    },
    {
      "source": "/growth-os/:path*",
      "destination": "https://blutenstein.com/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
