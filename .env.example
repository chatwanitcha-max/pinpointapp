PINPOINT_CHAT_REPLY_MODE=local
PINPOINT_CHAT_LEAD_CAPTURE=true

# OpenAI Integration for truly smart AI replies
# Set PINPOINT_CHAT_REPLY_MODE=smart AND add OPENAI_API_KEY to enable LLM-powered responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.7

# Kimi (Moonshot AI) — OpenAI-compatible API, great for Thai/Chinese/English
# Alternative to OpenAI. Set KIMI_API_KEY instead of OPENAI_API_KEY if you prefer Kimi.
# Get your key at: https://platform.moonshot.cn/
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
